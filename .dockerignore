# .dockerignore

# ========================
# Node / Next.js
# ========================
node_modules
.next
out

# ========================
# Environment — never send dotenv files (including tracked .env.production) to the builder.
# ========================
.env*

# ========================
# Logs
# ========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# OS / Editor
# ========================
.DS_Store
Thumbs.db
.vscode
.idea
*.swp

# ========================
# Git
# ========================
.git
.gitignore

# ========================
# Docker / Build
# ========================
.docker
docker-compose.override.yml
docker-compose.dev.yml
tmp
build
