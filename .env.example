##############################################
# 🧩 SaaSKit .env (ProKit engine, single-tenant runtime)
##############################################
APP_SLUG=saaskit   # single source of truth for this app's tenant slug
PROCHAT_VERSION=1.0.46

# Optional: one-time migration helper when you rename the repo/app slug and
# want production to auto-rename the existing tenant schema/user on next deploy.
# Remove after a successful deploy.
LEGACY_APP_SLUG=

# The app always runs on a single connection scoped to tenant_<APP_SLUG>.
# DATABASE_URL points to tenant_<APP_SLUG>_user with schema tenant_<APP_SLUG>.
DATABASE_URL=postgresql://tenant_saaskit_user:password@localhost:5433/postgres?schema=tenant_saaskit

# SYSTEM_DATABASE_URL is only used by provisioning/migration/cleanup scripts.
SYSTEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?schema=public

# SHADOW_DATABASE_URL is required for Prisma migrate dev (use admin creds).
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?schema=public

# Recommended in production: set TENANT_DB_PASSWORD (alphanumeric only) so the
# tenant DB user password is deterministic across deploys.
TENANT_DB_PASSWORD=password

# --------------------------------------------
# ⚙️ N8N (optional)
N8N_API_KEY=
N8N_API_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --------------------------------------------
# 🗄️ LOCAL POSTGRES (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=postgres
POSTGRES_PORT=5433
# Docker compose maps POSTGRES_PORT on the host to 5432 in the container.

# --------------------------------------------
# 💳 STRIPE (optional for SaaS billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example

# --------------------------------------------
# 🔐 CLERK (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_SECRET_KEY=sk_test_example
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --------------------------------------------
# 🌐 APP BASE URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --------------------------------------------
# ✉️ RESEND (email)
RESEND_API_KEY=

# --------------------------------------------
# 📰 BLOG (WordPress optional)
WP_REST_ENDPOINT=https://example.com/wp-json
