##############################################
# 🧩 ProChat .env (single-tenant runtime)
##############################################
APP_SLUG=myapp   # single source of truth for this app's tenant slug
PORT=3056

# The app always runs on a single connection scoped to tenant_<APP_SLUG>.
# DATABASE_URL points to tenant_<APP_SLUG>_user with schema tenant_<APP_SLUG>.
# IMPORTANT: both dev and prod assume the database already exists.
# Provisioning creates/updates schema + role only; it never creates a database.
DATABASE_URL=postgresql://tenant_myapp_user:password@localhost:5433/postgres?schema=tenant_myapp

# SYSTEM_DATABASE_URL is only used by provisioning/migration/cleanup scripts.
# In production this points to the existing Supabase Postgres database.
SYSTEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?schema=public
# SHADOW_DATABASE_URL is used by Prisma migrate dev (shadow DB).
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?schema=public

# Scripts in production also expect TENANT_DB_PASSWORD for provisioning.
TENANT_DB_PASSWORD=password

# --------------------------------------------
# 🔧 MAKE (optional: for automation scripts)
MAKE_ORGANIZATION_ID=
MAKE_TEAM_ID=
MAKE_API_KEY=
MAKE_API_URL=https://api.make.com/v2

# --------------------------------------------
# ⚙️ N8N (optional)
N8N_API_KEY=
N8N_API_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --------------------------------------------
# 🗄️ LOCAL POSTGRES (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=postgres
# Docker compose maps 5433 on the host to 5432 in the container.

# 💳 STRIPE (optional for SaaS billing)
# Active Stripe mode: test | live
STRIPE_MODE=test
# Client helper mode (must match STRIPE_MODE for checkout)
NEXT_PUBLIC_STRIPE_MODE=test

# Publishable keys (safe for client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_example
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_example

# Secret keys (server only)
STRIPE_SECRET_KEY_TEST=sk_test_example
STRIPE_SECRET_KEY_LIVE=sk_live_example
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_example
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_example

# Store: ProKit product IDs
STRIPE_PRICE_PROKIT_TEST=price_test_prokit_example
STRIPE_PRICE_PROKIT_LIVE=price_live_prokit_example
STRIPE_PRODUCT_PROKIT_TEST=prod_test_prokit_example
STRIPE_PRODUCT_PROKIT_LIVE=prod_live_prokit_example

# Store: SaaSkit product IDs
STRIPE_PRICE_SAASKIT_TEST=price_test_saaskit_example
STRIPE_PRICE_SAASKIT_LIVE=price_live_saaskit_example
STRIPE_PRODUCT_SAASKIT_TEST=prod_test_saaskit_example
STRIPE_PRODUCT_SAASKIT_LIVE=prod_live_saaskit_example

# GitHub App auth (server-side collaborator invites)
GITHUB_APP_ID=123456
# Base64-encoded PEM private key for the GitHub App
GITHUB_APP_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQo...
# Installation ID for the app installation that has access to both repos
GITHUB_APP_INSTALLATION_ID=12345678

# --------------------------------------------
# 🔐 SHARED AUTH UI + Ory backend
# This repo can serve the shared auth UI for other apps while Ory stays the backend.
NEXT_PUBLIC_AUTH_UI_URL=https://prochat.tools
NEXT_PUBLIC_ORY_PUBLIC_URL=https://auth.prochat.tools
ORY_ADMIN_URL=https://auth-admin.prochat.tools
ORY_ADMIN_API_KEY=
ORY_PROJECT_ID=

# --------------------------------------------
# 🔐 CLERK (legacy / optional fallback)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_SECRET_KEY=sk_test_example
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Admin allowlist for /admin routes in production. At least one of these must be set.
ADMIN_EMAILS=admin@prochat.tools
ADMIN_CLERK_IDS=

# --------------------------------------------
# 🌐 APP BASE URL
NEXT_PUBLIC_APP_URL=http://localhost:3056
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.prochat.tools/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=5ceba17d-4125-4a75-a1f6-9add5c4b1803

# --------------------------------------------
# ✉️ RESEND (email)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=info@prochat.tools
SUPPORT_EMAIL=support@prochat.tools
# Legacy fallback for contact inbox routing (optional)
CONTACT_TO_EMAIL=
# Waitlist-specific overrides (optional)
WAITLIST_FROM_EMAIL=
WAITLIST_ADMIN_EMAIL=


# --------------------------------------------
# 📬 MAILERLITE (funnel form API)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=179224742687934207
MAILERLITE_API_BASE_URL=https://connect.mailerlite.com/api

# --------------------------------------------
# 🧪 MOCK USER (used for seeding & imports)
MOCK_USER_ID=local-test
