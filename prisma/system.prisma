generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum SubscriptionStatus {
  active
  inactive
}

enum ProductType {
  saaskit
  prokit
  uxkit
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum ProvisioningStatus {
  pending
  in_progress
  completed
  failed
}

enum AccessStatus {
  pending
  invited
  active
  revoked
}

enum LicenseEventType {
  purchase_completed
  github_username_linked
  collaborator_invited
  access_revoked
  revocation_email_sent
  access_restored
  license_reactivated
}

model Subscription {
  id                String              @id
  user_email        String              @unique
  sub_status        SubscriptionStatus  @default(inactive)
  sub_type          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  last_stripe_cs_id String              @unique
  stripe_customer_id String             @unique
  sub_stripe_id     String?
  user_clerk_id     String              @unique
}

model Project {
  id             String   @id
  connection_id  String
  webhook_id     String
  scenario_id    String
  user_clerk_id  String
  type           String
  status         String   @default("default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  webhookLink    String
  assistant_id   String?
}

model Audiences {
  id        String @id
  resend_id String @unique
  name      String
}

model WaitlistSignup {
  id                    String   @id @default(cuid())
  email                 String
  selected_products     Json
  selected_products_csv String
  source                String    @default("waitlist")
  unsubscribe_token     String?   @unique
  unsubscribed_at       DateTime?
  created_at            DateTime  @default(now())

  @@index([source, created_at])
}

model License {
  id                 String             @id @default(cuid())
  purchaser_email    String
  product            ProductType
  payment_reference  String             @unique
  payment_status     PaymentStatus      @default(pending)
  provisioning_status ProvisioningStatus @default(pending)
  access_status      AccessStatus       @default(pending)
  github_username    String?
  revoked_at         DateTime?
  revoked_reason     String?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  events LicenseEvent[]

  @@index([product, access_status])
}

model LicenseEvent {
  id          String           @id @default(cuid())
  license     License          @relation(fields: [license_id], references: [id])
  license_id  String
  type        LicenseEventType
  metadata    Json?
  created_at  DateTime         @default(now())

  @@index([license_id, type])
}
