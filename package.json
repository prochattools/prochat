{
  "name": "@prochat/saaskit",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "ProKit – ProChat’s SaaS starter for micro-SaaS apps.",
  "author": "Steve Westhoek",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "sh scripts/start-production.sh",
    "generate:social": "tsx scripts/generate-social-images.ts",
    "sitemap": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' -r tsconfig-paths/register scripts/generate-sitemap.ts",
    "rss": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' -r tsconfig-paths/register scripts/generate-rss.ts",
    "provision:auto": "node scripts/provision-auto.js",
    "postinstall": "prisma generate --schema=prisma/system.prisma",
    "db:init": "node scripts/db/init-tenant.js",
    "db:cleanup": "node scripts/db/cleanup-tenant.js",
    "db:migrate:dev": "prisma migrate dev --schema=prisma/system.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/system.prisma",
    "predev": "node scripts/dev/bootstrap-env.js && npm run db:init && npm run db:migrate:dev",
    "db:provision:local": "NODE_ENV=development npm run provision:auto",
    "lint:design": "node scripts/design/lint-design-system.mjs",
    "lint:design:baseline": "node scripts/design/lint-design-system.mjs --write-baseline",
    "docs:generate": "ts-node --transpile-only scripts/docs/generate-docs.ts",
    "docs:clean": "node -e \"const {rm} = require('fs/promises'); const targets = ['src/content/docs/prokit','src/content/docs/saaskit','src/content/docs/waaskit','src/content/docs/future']; Promise.all(targets.map(t => rm(t, { recursive: true, force: true }))).catch(() => {});\"",
    "docs:preview": "npm run docs:generate && npx next dev -p 3100",
    "docs:check:coverage": "tsx scripts/docs/check-doc-coverage.ts",
    "docs:validate": "npm run docs:check:coverage && tsx scripts/docs/validate-docs.ts",
    "docs:ai-generate": "tsx scripts/docs/ai/generate-ai-doc.ts",
    "docs:ai-build": "npm run docs:ai-generate && npm run docs:generate && npm run docs:validate",
    "docs:ingest": "ts-node --transpile-only scripts/docs/ingest/external-sync.ts",
    "docs:extract:typescript": "ts-node --transpile-only scripts/docs/extract/extract-typescript.ts",
    "docs:extract:openapi": "ts-node --transpile-only scripts/docs/extract/extract-openapi.ts",
    "docs:extract:repo": "ts-node --transpile-only scripts/docs/extract/extract-repo.ts",
    "docs:extract": "npm run docs:extract:typescript && npm run docs:extract:openapi",
    "docs:restructure": "ts-node --transpile-only scripts/docs/restructure-product-docs.ts",
    "docs:watch": "tsx scripts/docs/watch-docs.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.1",
    "@fontsource/jetbrains-mono": "^5",
    "@mdx-js/loader": "^2.3.0",
    "@mdx-js/react": "^2.3.0",
    "@next/mdx": "^13.5.6",
    "@next/third-parties": "^14.2.5",
    "@prisma/client": "6.7.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-email/components": "^0.0.25",
    "@stripe/stripe-js": "^4.7.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "form-data": "^4.0.0",
    "formik": "^2.4.6",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.2",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.408.0",
    "next": "^14.2.31",
    "next-themes": "^0.4.4",
    "nextjs-toploader": "^1.6.11",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "pg": "^8.12.0",
    "prop-types": "^15.8.1",
    "radix-ui": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email": "^3.0.1",
    "react-hot-toast": "^2.4.1",
    "react-responsive-masonry": "^2.4.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-to-print": "^2.15.1",
    "react-tooltip": "^5.26.3",
    "resend": "^4.0.0",
    "sass": "^1.82.0",
    "stripe": "^16.12.0",
    "tailwind-merge": "^2.4.0",
    "yup": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@types/jest": "^29.5.12",
    "@types/mdx": "^2.0.12",
    "@types/node": "^20",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.31",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "prisma": "6.7.0",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
